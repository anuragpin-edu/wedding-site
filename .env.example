# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# Supabase — get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-only — never use NEXT_PUBLIC_ prefix

# Admin dashboard — comma-separated emails allowed into /admin (Phase 6)
ADMIN_EMAILS=

# Cloudflare R2 — Phase 7
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
NEXT_PUBLIC_R2_PUBLIC_URL=        # public CDN URL for the R2 bucket

# Cloudflare Stream — Phase 7
CLOUDFLARE_STREAM_TOKEN=

# VAPID keys for Web Push — Phase 8 (generate once with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                # server-only
VAPID_SUBJECT=mailto:you@example.com  # contact for push services (mailto: or https:)

# Cloudflare Turnstile — Phase 10
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
